# iPedro / Dale — copy to `.env` and fill in the blanks:
#
#     cp .env.example .env
#
# Lines starting with `#` show a setting at its default (ipedro/config.py is
# the source of truth); uncomment one to change it. Anything not listed here
# falls back to that default.
#
# DOCKER: Compose uses this file twice, differently. `env_file` hands the
# values to the containers, but the ${POSTGRES_*} / ${PGDATA_HOST_PATH}
# substitutions inside docker-compose.yml are read by Compose itself, from
# the project directory only. Start the stack with the flag, or those lines
# of this file are silently ignored and the defaults win:
#
#     cd docker && docker compose --env-file ../.env up -d --build

# ── Required ────────────────────────────────────────────────────────────────

# From @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=
# Embeddings, image generation, transcription and speech always go to OpenAI.
OPENAI_API_KEY=
# For `python -m ipedro` on the host. Under Docker Compose this is overridden
# to point at the `postgres` service, built from the POSTGRES_* values below.
DATABASE_URL=postgresql://ipedro:ipedro@localhost:5432/ipedro

# ── Docker Compose only (docker/docker-compose.yml) ─────────────────────────

# The Postgres container's database, user and password. They only take effect
# the FIRST time Postgres initializes its data directory; changing the password
# later needs `ALTER USER` inside the database too.
#POSTGRES_DB=ipedro
#POSTGRES_USER=ipedro
#POSTGRES_PASSWORD=ipedro
# Where Postgres keeps its data on the host. Under appdata so the Unraid
# Appdata Backup plugin sees it; use ./pgdata for a local checkout.
#PGDATA_HOST_PATH=/mnt/user/appdata/ipedro/pgdata

# ── Who runs the bot ────────────────────────────────────────────────────────

# Comma-separated Telegram user ids allowed to use the admin commands. The
# owner's id is always included; only the owner can approve /evolve and
# /newbot requests.
#ADMIN_USER_IDS=315660812
#LOG_LEVEL=INFO
#BOT_TIMEZONE=America/Los_Angeles

# ── Models ──────────────────────────────────────────────────────────────────

# Optional but recommended: text goes to Claude. Without it the bot falls back
# to OpenAI for text too. /ai_provider and /ai_model change these at runtime.
ANTHROPIC_API_KEY=
#TEXT_PROVIDER=claude
#CLAUDE_TEXT_MODEL=claude-sonnet-5
#CLAUDE_CHEAP_MODEL=claude-haiku-4-5
#OPENAI_ORGANIZATION=
#OPENAI_TEXT_MODEL=gpt-4o-mini
#OPENAI_CHEAP_MODEL=gpt-4o-mini
#OPENAI_IMAGE_MODEL=gpt-image-1
#OPENAI_TRANSCRIPTION_MODEL=whisper-1
#OPENAI_EMBEDDING_MODEL=text-embedding-3-small
#OPENAI_EMBEDDING_DIM=1536
#OPENAI_TTS_MODEL=gpt-4o-mini-tts
#OPENAI_TTS_VOICE=onyx
# How long the stable prompt prefix stays in Anthropic's cache: 5m or 1h.
#CACHE_TTL=1h

# ── Identity (see docs/DEPLOY.md, "Other bots") ─────────────────────────────

# Unset means Dale. Set these to run the same code as a different bot.
#BOT_NAME=Dale
# Other names people call it by, comma-separated.
#BOT_ALIASES=
# `plain` drops Dale's catchphrases, GIF library and /start blurb.
#BOT_FLAVOR=dale
# The persona it starts with, until /master_prompt changes it.
#BOT_PERSONA=
# Whether this deployment is the one that adds and manages the other bots.
#MANAGES_BOTS=true
# Largest pool of Postgres connections this process may hold. Every bot holds
# its own, against one server whose max_connections defaults to 100.
#DB_POOL_MAX=10
# Where the bots hear each other: Dale's database. Unset = this bot's own.
#HUB_DATABASE_URL=

# ── /evolve (the owner asking the bot to change itself) ─────────────────────

# A fine-grained PAT scoped to the one repo, Issues read/write and NOTHING
# else. Unset: /evolve explains what's missing instead of failing.
EVOLVE_GITHUB_TOKEN=
#EVOLVE_GITHUB_REPO=moistifarius/ipedro-v3

# ── Memory and context ──────────────────────────────────────────────────────

#CONTEXT_RECENT_MESSAGES=20
#CONTEXT_MAX_TOKENS=6000
#SUMMARY_TRIGGER_MESSAGES=80
#SUMMARY_KEEP_RECENT=20
#SEMANTIC_RETRIEVAL_K=6

# ── Per-chat defaults (used when a chat is first seen) ──────────────────────

#DEFAULT_RESPONSE_POLICY_PRIVATE=always
#DEFAULT_RESPONSE_POLICY_GROUP=mention
#DEFAULT_AMBIENT_PROBABILITY=0.03
#DEFAULT_PERSONA=dude

# ── Duck hunt ───────────────────────────────────────────────────────────────

#DUCKHUNT_ENABLED_BY_DEFAULT=false
# Spawns are a Poisson process per chat; this is the mean gap (~48h).
#DUCKHUNT_MEAN_SPAWN_INTERVAL_SECONDS=172800
#DUCKHUNT_SPAWN_TICK_SECONDS=60
#DUCKHUNT_DUCK_LIFETIME_SECONDS=86400
#DUCKHUNT_DUCK_HALF_LIFE_SECONDS=14400
#DUCKHUNT_ACTION_COOLDOWN_SECONDS=4

# ── Shared photos ───────────────────────────────────────────────────────────

#SHARE_PHOTO_ENABLED_BY_DEFAULT=false
#SHARE_PHOTO_MEAN_INTERVAL_SECONDS=86400
#SHARE_PHOTO_TICK_SECONDS=300

# ── Memes (/redditmeme and "meme about X") ──────────────────────────────────

# Reddit blocks anonymous requests from most servers; create a "script" app at
# https://www.reddit.com/prefs/apps and fill both in.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
#REDDIT_USER_AGENT=python:ipedro:1.0 (by /u/moistifarius)
# Free extra sources: developers.giphy.com, and api.imgur.com/oauth2/addclient
# (anonymous usage). Unset = skipped.
GIPHY_API_KEY=
IMGUR_CLIENT_ID=

# ── /ether radio effect ─────────────────────────────────────────────────────

# Comma-separated failover list of live sources to mix in (kiwi://host:port?...
# for a KiwiSDR, or a stream URL). See docs/COMMANDS.md.
#RADIO_FX_LIVE_URLS=
